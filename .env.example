# Copy to .env and adjust. Never commit .env.

# PostgreSQL (used by docker-compose and by the pipeline)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fuel
POSTGRES_USER=fuel
POSTGRES_PASSWORD=change-me

# Source API
API_BASE_URL=https://sedeaplicaciones.minetur.gob.es/ServiciosRESTCarburantes/PreciosCarburantes
API_TIMEOUT_SECONDS=60
API_MAX_RETRIES=3

# Pipeline
RAW_DIR=data/raw
LOG_LEVEL=INFO
